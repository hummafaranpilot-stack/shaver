# FB Traffic Detector — /traffic .htaccess
# Force HTTPS within /traffic and protect sensitive files

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

# Block direct access to the domain registry + raw log JSON files
<FilesMatch "^(domains\.json|.*\.log|\.rate_.*|\.ipqs_.*)$">
    Require all denied
</FilesMatch>

# Allow snippet.js to be requested cross-origin (lander on different domain)
<IfModule mod_headers.c>
    <FilesMatch "^snippet\.js$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>
</IfModule>

# Default file
DirectoryIndex index.php

# Disable directory listing
Options -Indexes
