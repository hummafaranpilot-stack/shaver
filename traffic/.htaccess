# FB Traffic Detector — /traffic .htaccess

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

# CORS for snippet.js — landers on different domains pull this asset
<IfModule mod_headers.c>
    <FilesMatch "^snippet\.js$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>
</IfModule>

# Block direct access to the auxiliary log files (blocked_ips.json, cross_origin.log)
<FilesMatch "^(blocked_ips\.json|cross_origin\.log)$">
    Require all denied
</FilesMatch>

DirectoryIndex index.html
Options -Indexes
